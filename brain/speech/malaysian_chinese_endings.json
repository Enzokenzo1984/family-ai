{
  "schemaVersion": "1.0",
  "baseVersion": "v11.1.1",
  "engineVersion": "v11.4",
  "language": "zh-MY",
  "name": "Malaysian Chinese Ending Rules",
  "principles": [
    "有“吗”或问号的问句直接结束，不再加呀、呢或咯",
    "安慰、建议、提醒类短句优先使用咯",
    "温柔回应、认同、鼓励类短句可以使用呀",
    "不是每一句都要加语尾",
    "避免连续多句重复同一个语尾",
    "“呀”希望由 TTS 读成接近马来西亚华语的 ah 语气"
  ],
  "examples": {
    "questions": [
      "吃饭了吗？",
      "今天累吗？",
      "睡得好吗？"
    ],
    "useLo": [
      "慢慢来咯。",
      "慢慢做就好咯。",
      "不用急咯。",
      "今天早点休息咯。"
    ],
    "useYa": [
      "好呀。",
      "可以呀。",
      "妈妈知道呀。",
      "放心呀。"
    ],
    "noParticle": [
      "我知道。",
      "妈妈明白。",
      "明天再继续。"
    ]
  },
  "forbidden": [
    "吃饭了吗呢？",
    "吃饭了吗呀？",
    "今天累吗咯？",
    "连续三句都使用呀",
    "连续三句都使用咯"
  ]
}